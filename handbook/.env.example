# Template for handbook/.env (git-ignored). Copy it, then replace the DUMMY values with your
# own keys, only for the modules you run:
#   cp handbook/.env.example handbook/.env
#
# Every value below is a DUMMY placeholder, not a working key. Never commit handbook/.env.
# Notebooks load it with python-dotenv: load_dotenv(find_dotenv()).
# Never paste keys into notebook cells, and never display them: outputs are saved into the .ipynb.
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENV=your-pinecone-environment
TAVILY_API_KEY=your-tavily-api-key
SERPAPI_KEY=your-serpapi-key
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=false
# Module 001 (todo API): where the SQLite file lives
TODO_DB_PATH=./todos.db
