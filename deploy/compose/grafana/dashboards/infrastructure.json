{
  "uid": "infrastructure",
  "title": "Infrastructure - Host & Database",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "sentinel"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU utilisation by state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (rate(system_cpu_time_seconds_total{state!=\"idle\"}[1m]))",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
