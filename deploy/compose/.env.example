# Copy to .env and run scripts/bootstrap-env.sh to replace every CHANGE_ME with a random secret.
# Never commit .env.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Bearer token Alertmanager uses on Sentinel's webhook (>= 24 chars).
SENTINEL_WEBHOOK_TOKEN=CHANGE_ME
# Token Sentinel presents to the demo services' admin API when executing remediations.
DEMO_ADMIN_TOKEN=CHANGE_ME
# name:role:sha256(key) entries. bootstrap-env.sh generates admin/operator/viewer keys and
# prints the raw keys once. Generate more with: docker compose run --rm sentinel-api sentinel gen-key NAME ROLE
SENTINEL_API_KEYS=CHANGE_ME

# AI provider: deterministic (offline, default) | openai | anthropic
SENTINEL_LLM_PROVIDER=deterministic
SENTINEL_LLM_MODEL=
SENTINEL_OPENAI_API_KEY=
SENTINEL_ANTHROPIC_API_KEY=

# Optional Slack-compatible incoming webhook for incident notifications.
SENTINEL_NOTIFICATION_WEBHOOK_URL=

# Optional discovery service (profile "discovery"). `make up-discovery` sets these for you;
# leave them empty for the default stack.
SENTINEL_DISCOVERY_URL=
SENTINEL_DISCOVERY_TOKEN=
