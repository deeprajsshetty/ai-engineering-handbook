# =============================================================================
# ai-engineering-handbook — .gitignore
# Rule of thumb: commit source, configuration templates and small fixtures.
# Never commit secrets, local databases, virtualenvs, caches or build output.
# =============================================================================

# ---- Secrets & local configuration ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.streamlit/secrets.toml
secrets/
!deploy/k8s/**/secrets/
*.kubeconfig
kubeconfig

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
.python-version
pip-log.txt

# Virtual environments (any name)
.venv/
venv/
env/
ENV/
genai/
**/pyvenv.cfg

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml
.cache/

# ---- Notebooks ---------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---- Local data & runtime artefacts -----------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
.langchain.db
*.log
logs/
*.pid
reports/
locust_*.csv
locust_*.html

# ---- Archive (items moved out for manual review/deletion; see _archive/MANIFEST.md)
_archive/

# ---- OS / IDE ----------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Infrastructure state ----------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*

# Kubernetes dev secret (generated from secrets.env.example)
deploy/k8s/overlays/dev/secrets.env
